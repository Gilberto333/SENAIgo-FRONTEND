# URL base da API (sem barra no final).
# Em /api o Vite encaminha as chamadas para VITE_DEV_PROXY_TARGET (veja o README).
VITE_API_URL=http://localhost:3000

# Tempo máximo de espera por resposta da API, em milissegundos.
VITE_API_TIMEOUT_MS=10000

# Total de áreas do SENAI usado na barra de progresso.
VITE_TOTAL_AREAS=10

# Tempo (ms) em que o mesmo QR Code é ignorado depois de lido.
VITE_SCAN_COOLDOWN_MS=3000

# --- Apenas desenvolvimento (servidor do Vite) ---
VITE_DEV_PORT=5173
# true = serve o app em HTTPS (necessário para a câmera no celular)
VITE_DEV_HTTPS=false
# Destino do proxy /api. Deixe vazio se não for usar.
VITE_DEV_PROXY_TARGET=
